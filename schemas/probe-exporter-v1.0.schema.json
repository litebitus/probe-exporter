{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litebitus/probe-exporter/schemas/probe-exporter-v1.0.schema.json",
  "title": "probe-exporter configuration v1.0",
  "description": "What the exporter probes: its targets, each with the probers that check it, and each prober's settings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "probers",
    "probe_targets"
  ],
  "properties": {
    "version": {
      "description": "The configuration format the file is written in: `1.0`, or `1` for the newest 1.x the exporter knows.",
      "enum": [
        "1",
        "1.0"
      ]
    },
    "probers": {
      "description": "Prober name to its settings.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "certificate": {
          "description": "Settings of the `certificate` prober, which checks the certificate a target presents for each host it serves.",
          "$ref": "#/$defs/certificate_settings"
        },
        "dns": {
          "description": "Settings of the `dns` prober, which asks a target, a DNS server, for each host it serves.",
          "$ref": "#/$defs/check_timing"
        },
        "domain_registration": {
          "description": "Settings of the `domain_registration` prober, which reads when a domain's registration expires.",
          "$ref": "#/$defs/check_timing"
        },
        "http": {
          "description": "Settings of the `http` prober, which requests a path from a target for each host it serves.",
          "$ref": "#/$defs/http_settings"
        },
        "ping": {
          "description": "Settings of the `ping` prober, which pings a target.",
          "$ref": "#/$defs/check_timing"
        },
        "tcp": {
          "description": "Settings of the `tcp` prober, which connects to a target's ports.",
          "$ref": "#/$defs/tcp_settings"
        }
      }
    },
    "probe_targets": {
      "description": "Target name to the target: what is probed, and the probers that check it.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/target_name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/probe_target"
      }
    }
  },
  "$defs": {
    "duration": {
      "description": "A duration, such as `500ms`, `10s` or `1h30m`.",
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "target_name": {
      "description": "A target's name, such as `mock-alb` or `example.com`.",
      "type": "string",
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "host_name": {
      "description": "A host name without a wildcard, such as `www.example.com`.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?(\\.[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?)*\\.?$"
    },
    "address": {
      "description": "A host without a port, such as `www.example.com`, `192.0.2.10` or `2001:db8::1`.",
      "type": "string",
      "pattern": "^([A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?(\\.[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?)*\\.?|[0-9A-Fa-f.]*:[0-9A-Fa-f.]*:[0-9A-Fa-f:.]*(%[A-Za-z0-9_.-]+)?)$"
    },
    "interval": {
      "description": "How often the prober checks each target.",
      "$ref": "#/$defs/duration"
    },
    "timeout": {
      "description": "How long one check may take.",
      "$ref": "#/$defs/duration"
    },
    "ports": {
      "description": "The ports the prober connects to, such as `443`.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "check_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval",
        "timeout"
      ],
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        }
      }
    },
    "certificate_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval",
        "timeout",
        "ports"
      ],
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "$ref": "#/$defs/ports"
        }
      }
    },
    "http_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval",
        "timeout",
        "ports",
        "path",
        "status_codes"
      ],
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "$ref": "#/$defs/ports"
        },
        "path": {
          "description": "The path requested, such as `/healthz`.",
          "type": "string",
          "pattern": "^/"
        },
        "status_codes": {
          "description": "The status codes that answer the request successfully, such as `200`.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        }
      }
    },
    "tcp_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval",
        "timeout",
        "ports"
      ],
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "$ref": "#/$defs/ports"
        }
      }
    },
    "probe_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probers"
      ],
      "properties": {
        "probers": {
          "description": "The probers that check the target.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "certificate",
              "dns",
              "domain_registration",
              "http",
              "ping",
              "tcp"
            ]
          }
        },
        "addresses": {
          "description": "Where the target is reached, such as `www.example.com` or `192.0.2.10`.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "serves": {
          "description": "The hosts the target serves, such as `www.example.com`.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host_name"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "probers": {
                "contains": {
                  "enum": [
                    "certificate",
                    "dns",
                    "http",
                    "ping",
                    "tcp"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "addresses"
            ]
          },
          "else": {
            "properties": {
              "addresses": {
                "not": {
                  "description": "A target is given `addresses` only when a prober checking it connects to it."
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probers": {
                "contains": {
                  "enum": [
                    "certificate",
                    "dns",
                    "http"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "serves"
            ]
          },
          "else": {
            "properties": {
              "serves": {
                "not": {
                  "description": "A target is given `serves` only when a prober checking it asks for its hosts."
                }
              }
            }
          }
        }
      ]
    }
  }
}
