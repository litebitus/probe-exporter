{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litebitus/probe-exporter/schemas/probe-exporter-v1.0.schema.json",
  "title": "probe-exporter configuration v1.0",
  "description": "What the exporter probes: its targets, each with the probers that check it, and each prober's settings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "probers",
    "probe_targets"
  ],
  "properties": {
    "version": {
      "description": "The configuration format the file is written in: `1.0`, or `1` for the newest 1.x the exporter knows.",
      "enum": [
        "1",
        "1.0"
      ]
    },
    "probers": {
      "description": "Prober name to its settings, which every target the prober checks takes unless the target states its own.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "certificate": {
          "description": "Settings of the `certificate` prober, which checks the certificate a target presents for each host it serves.",
          "allOf": [
            {
              "$ref": "#/$defs/certificate_settings"
            },
            {
              "$ref": "#/$defs/timing_required"
            }
          ]
        },
        "dns": {
          "description": "Settings of the `dns` prober, which asks a target, a DNS server, for the records of each host it serves.",
          "allOf": [
            {
              "$ref": "#/$defs/dns_settings"
            },
            {
              "$ref": "#/$defs/timing_required"
            }
          ]
        },
        "domain_registration": {
          "description": "Settings of the `domain_registration` prober, which reads when a domain's registration expires.",
          "allOf": [
            {
              "$ref": "#/$defs/domain_registration_settings"
            },
            {
              "$ref": "#/$defs/timing_required"
            }
          ]
        },
        "http": {
          "description": "Settings of the `http` prober, which requests a path from a target as each host it serves.",
          "allOf": [
            {
              "$ref": "#/$defs/http_settings"
            },
            {
              "$ref": "#/$defs/timing_required"
            }
          ]
        },
        "ping": {
          "description": "Settings of the `ping` prober, which pings a target.",
          "allOf": [
            {
              "$ref": "#/$defs/ping_settings"
            },
            {
              "$ref": "#/$defs/timing_required"
            }
          ]
        },
        "tcp": {
          "description": "Settings of the `tcp` prober, which connects to a target's ports.",
          "allOf": [
            {
              "$ref": "#/$defs/tcp_settings"
            },
            {
              "$ref": "#/$defs/timing_required"
            }
          ]
        }
      }
    },
    "probe_targets": {
      "description": "Target name to the target: what is probed, and the probers that check it.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/target_name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/probe_target"
      }
    }
  },
  "$defs": {
    "duration": {
      "description": "A duration, such as `500ms`, `10s` or `1h30m`.",
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "target_name": {
      "description": "A target's name, such as `mock-alb` or `example.com`.",
      "type": "string",
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "host_name": {
      "description": "A host name without a wildcard, such as `www.example.com`.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?(\\.[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?)*\\.?$"
    },
    "address": {
      "description": "A host name without a port, such as `www.example.com`.",
      "type": "string",
      "pattern": "^([A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?(\\.[A-Za-z0-9_]([A-Za-z0-9_-]*[A-Za-z0-9_])?)*\\.?|[0-9A-Fa-f.]*:[0-9A-Fa-f.]*:[0-9A-Fa-f:.]*(%[A-Za-z0-9_.-]+)?)$"
    },
    "interval": {
      "description": "How often the prober checks each target.",
      "$ref": "#/$defs/duration"
    },
    "timeout": {
      "description": "How long one check may take.",
      "$ref": "#/$defs/duration"
    },
    "timing_required": {
      "required": [
        "interval",
        "timeout"
      ]
    },
    "port_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    },
    "certificate_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "description": "The ports the prober connects to, each a port and its protocol, such as `443/tcp`.",
          "$ref": "#/$defs/port_list",
          "items": {
            "type": "string",
            "pattern": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})/tcp$"
          }
        }
      }
    },
    "dns_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "description": "The ports the prober asks on, each a port and its protocol, such as `53/udp` or `53/tcp`.",
          "$ref": "#/$defs/port_list",
          "items": {
            "type": "string",
            "pattern": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})/(tcp|udp)$"
          }
        },
        "record_types": {
          "description": "The record types asked for each host, such as `A` or `AAAA`.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A",
              "AAAA",
              "CAA",
              "CNAME",
              "MX",
              "NS",
              "PTR",
              "SOA",
              "SRV",
              "TXT"
            ]
          }
        }
      }
    },
    "domain_registration_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "description": "How the prober asks the domain's registry: `443/rdap`, RDAP over HTTPS.",
          "$ref": "#/$defs/port_list",
          "items": {
            "const": "443/rdap"
          }
        },
        "info_labels": {
          "description": "The facts of the registration the prober publishes, each a label of `probe_domain_registration_info`; none where left out.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "const": "name_servers",
                "description": "The domain's name servers, lower case, in name order and joined by `, `."
              },
              {
                "const": "registrar",
                "description": "The name of the domain's registrar."
              }
            ]
          }
        }
      }
    },
    "http_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "description": "The ports the prober requests on, each a port and its protocol, such as `443/https` or `80/http`.",
          "$ref": "#/$defs/port_list",
          "items": {
            "type": "string",
            "pattern": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})/(http|https)$"
          }
        },
        "path": {
          "description": "The path requested, such as `/healthz`.",
          "type": "string",
          "pattern": "^/"
        },
        "status_codes": {
          "description": "The status codes that answer the request successfully, such as `200`.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        }
      }
    },
    "ping_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "description": "The ICMP message the prober sends, its type where a port goes: `8/icmp`, an echo request.",
          "$ref": "#/$defs/port_list",
          "items": {
            "const": "8/icmp"
          }
        }
      }
    },
    "tcp_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "ports": {
          "description": "The ports the prober connects to, each a port and its protocol, such as `5432/tcp`.",
          "$ref": "#/$defs/port_list",
          "items": {
            "type": "string",
            "pattern": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})/tcp$"
          }
        }
      }
    },
    "probe_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probers"
      ],
      "properties": {
        "probers": {
          "description": "Prober name to the settings it checks the target with, each overriding the prober's own.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "certificate": {
              "$ref": "#/$defs/certificate_settings"
            },
            "dns": {
              "$ref": "#/$defs/dns_settings"
            },
            "domain_registration": {
              "$ref": "#/$defs/domain_registration_settings"
            },
            "http": {
              "$ref": "#/$defs/http_settings"
            },
            "ping": {
              "$ref": "#/$defs/ping_settings"
            },
            "tcp": {
              "$ref": "#/$defs/tcp_settings"
            }
          }
        },
        "addresses": {
          "description": "Where the target is reached, such as `www.example.com`.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "serves": {
          "description": "The hosts the target serves, such as `www.example.com`; required for `dns`, and for `certificate` and `http` only where the hosts are not the addresses themselves.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host_name"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "probers": {
                "anyOf": [
                  {
                    "required": [
                      "certificate"
                    ]
                  },
                  {
                    "required": [
                      "dns"
                    ]
                  },
                  {
                    "required": [
                      "http"
                    ]
                  },
                  {
                    "required": [
                      "ping"
                    ]
                  },
                  {
                    "required": [
                      "tcp"
                    ]
                  }
                ]
              }
            }
          },
          "then": {
            "required": [
              "addresses"
            ]
          },
          "else": {
            "properties": {
              "addresses": {
                "not": {
                  "description": "A target is given `addresses` only when a prober checking it connects to it."
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probers": {
                "anyOf": [
                  {
                    "required": [
                      "certificate"
                    ]
                  },
                  {
                    "required": [
                      "dns"
                    ]
                  },
                  {
                    "required": [
                      "http"
                    ]
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "serves": {
                "not": {
                  "description": "A target is given `serves` only when a prober checking it asks for its hosts."
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "probers": {
                "required": [
                  "dns"
                ]
              }
            }
          },
          "then": {
            "required": [
              "serves"
            ]
          }
        }
      ]
    }
  }
}
